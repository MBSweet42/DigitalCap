rules_version = '2';
service cloud.firestore {
  function isAuthorizedAdmin() {
    return request.auth != null &&
           request.auth.uid == "3fdKe1IKJtP7DhQD0OZ2919STYH2";
  }

  match /databases/{database}/documents {
    match /{document=**} {
        allow read: if false;
        allow write: if false;
    }
  }
}
