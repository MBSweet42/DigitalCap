rules_version = '2';
service cloud.firestore {
  function isAuthorizedAdmin() {
    return request.auth != null &&
           request.auth.uid == "3fdKe1IKJtP7DhQD0OZ2919STYH2";
  }

  function isValidNewSubmission(data) {
    return isValidSubmissionFields(data) &&
           data.status == "pending" &&
           data.createdAt == request.time &&
           data.get('reviewedAt', null) == null &&
           data.get('reviewedBy', null) == null &&
           data.get('adminNotes', null) == null;
  }

  function isValidSubmissionFields(data) {
    // Core required fields (name + message for any submission)
    let hasValidCore = data.keys().hasAny(['appName', 'resourceName', 'message']) &&
           data.createdAt is timestamp &&
           data.status == "pending";

    // Check submissionType (optional, defaults to app_suggestion)
    let validType = !data.keys().hasAny(['submissionType']) ||
           (data.submissionType is string &&
            data.submissionType in ['app_suggestion', 'app_correction', 'resource_suggestion', 'website_problem', 'improvement', 'other']);

    // Optional fields with limits
    let optionalFieldsOk =
           (!data.keys().hasAny(['appName']) || (data.appName is string && data.appName.size() <= 100)) &&
           (!data.keys().hasAny(['resourceName']) || (data.resourceName is string && data.resourceName.size() <= 100)) &&
           (!data.keys().hasAny(['appUrl']) || (data.appUrl is string && data.appUrl.size() <= 500)) &&
           (!data.keys().hasAny(['resourceUrl']) || (data.resourceUrl is string && data.resourceUrl.size() <= 500)) &&
           (!data.keys().hasAny(['whyWeShould']) || (data.whyWeShould is string && data.whyWeShould.size() <= 500)) &&
           (!data.keys().hasAny(['message']) || (data.message is string && data.message.size() <= 1000)) &&
           (!data.keys().hasAny(['additionalNotes']) || (data.additionalNotes is string && data.additionalNotes.size() <= 1000)) &&
           (!data.keys().hasAny(['submitterName']) || (data.submitterName is string && data.submitterName.size() <= 100)) &&
           (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 100)) &&
           (!data.keys().hasAny(['sourcePage']) || (data.sourcePage is string && data.sourcePage.size() <= 200)) &&
           (!data.keys().hasAny(['sourceUrl']) || (data.sourceUrl is string && data.sourceUrl.size() <= 500)) &&
           (!data.keys().hasAny(['relatedApp']) || (data.relatedApp is string && data.relatedApp.size() <= 100)) &&
           (!data.keys().hasAny(['relatedAppId']) || (data.relatedAppId is string && data.relatedAppId.size() <= 100)) &&
           (!data.keys().hasAny(['suggestedCorrection']) || (data.suggestedCorrection is string && data.suggestedCorrection.size() <= 500)) &&
           (!data.keys().hasAny(['correctionDetails']) || (data.correctionDetails is string && data.correctionDetails.size() <= 500));

    return hasValidCore && validType && optionalFieldsOk;
  }

  function isValidAdminUpdate() {
    let currentStatus = resource.data.status;
    let newStatus = request.resource.data.status;

    // Allow valid state transitions:
    // pending → approved/rejected/reviewing/resolved
    // reviewing → resolved (or stay reviewing)
    // resolved → resolved (no change)
    let validTransition = (currentStatus == "pending") ||
                         (currentStatus == "reviewing" && (newStatus == "resolved" || newStatus == "reviewing")) ||
                         (currentStatus == "resolved");

    return request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'adminNotes']) &&
           validTransition &&
           request.resource.data.status in ["approved", "rejected", "reviewing", "resolved"] &&
           request.resource.data.reviewedBy == request.auth.uid &&
           request.resource.data.reviewedAt == request.time &&
           (!request.resource.data.keys().hasAny(['adminNotes']) ||
            (request.resource.data.adminNotes is string &&
             request.resource.data.adminNotes.size() <= 1000));
  }

  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // App Submissions Collection
    match /appSubmissions/{submissionId} {
      // Public can CREATE new submissions only
      allow create: if isValidNewSubmission(request.resource.data);

      // Admin can READ all submissions
      allow read: if isAuthorizedAdmin();

      // Admin can UPDATE moderation fields only
      allow update: if isAuthorizedAdmin() && isValidAdminUpdate();

      // No one can DELETE
      allow delete: if false;
    }

    // App Curation Collection
    match /appsCurations/{curationId} {
      // Admin only: read, create, update, delete
      allow read: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin();
      allow update: if isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();
    }

    // Published Apps Collection
    match /appsPublished/{docId} {
      // Public can READ published apps (unauthenticated)
      allow read: if true;

      // Admin only: CREATE, UPDATE, DELETE
      allow create: if isAuthorizedAdmin();
      allow update: if isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();
    }
  }
}
